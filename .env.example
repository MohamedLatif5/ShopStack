# Local development defaults. They match docker-compose.yml and contain no real secrets.
# Copy to .env and adjust if your setup differs.

# Main database used by `npm run start:dev` and `npm run migrate`.
DATABASE_URL="postgresql://shopstack:shopstack@localhost:5433/shopstack_dev?schema=public"

# Separate database used only by `npm run test:db`. The test suite recreates it on every run.
DATABASE_URL_TEST="postgresql://shopstack:shopstack@localhost:5433/shopstack_test?schema=public"

# Secret used to sign JWT access tokens. Generate your own local value, e.g. `openssl rand -hex 32`.
JWT_SECRET="change-me-generate-a-local-secret"

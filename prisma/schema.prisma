// ShopStack database schema.
// Prices are integers in piasters (1 EGP = 100 piasters) to avoid floating-point money.
// Stock is a non-negative integer on the product; every stock change is recorded
// in the InventoryMovement ledger (Feature 5).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum MovementReason {
  ADJUSTMENT
  RESTOCK
  SALE
  CANCELLATION
}

model User {
  id                 Int                @id @default(autoincrement())
  email              String             @unique
  passwordHash       String
  fullName           String?
  role               Role               @default(CUSTOMER)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  orders             Order[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id            Int                @id @default(autoincrement())
  name          String
  description   String?
  pricePiasters Int
  stock         Int                @default(0)
  status        ProductStatus      @default(ACTIVE)
  categoryId    Int?
  category      Category?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  movements     InventoryMovement[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([status])
  @@index([categoryId])
}

model InventoryMovement {
  id          Int            @id @default(autoincrement())
  productId   Int
  delta       Int
  reason      MovementReason @default(ADJUSTMENT)
  note        String?
  createdById Int?
  createdAt   DateTime       @default(now())
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([createdAt])
}

model CartItem {
  id         Int      @id @default(autoincrement())
  customerId Int
  productId  Int
  quantity   Int
  createdAt  DateTime @default(now())
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
}

model Order {
  id              Int         @id @default(autoincrement())
  customerId      Int
  status          OrderStatus @default(PENDING)
  totalPiasters   Int
  shippingName    String
  shippingPhone   String
  shippingAddress String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  customer        User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@index([customerId])
}

// Items are snapshots: name and unit price are frozen at purchase time,
// and the product link is deliberately nullable so deleting a product
// later never destroys order history (SetNull keeps the snapshot).
model OrderItem {
  id                 Int      @id @default(autoincrement())
  orderId            Int
  productId          Int?
  productName        String
  unitPricePiasters  Int
  quantity           Int
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}
